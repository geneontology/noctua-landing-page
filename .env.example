# App environment: dev | beta | prod
VITE_APP_ENV=dev

# Base href the workbench is served from (matches the workbench id)
VITE_BASE_URL=/workbench/noctua-landing-page/

# Build output directory
VITE_OUTPUT_PATH=workbenches/noctua-landing-page/public

# Dev-only overrides. In production the Noctua shell injects `window.global_*`
# globals and these are ignored. Point them at a reachable Barista/GOlr when
# running the app standalone via `npm run dev`.
# VITE_BARISTA_URL=http://barista-dev.berkeleybop.org
# VITE_GOLR_URL=https://golr-aux.geneontology.io/solr/
# VITE_GOLR_NEO_URL=http://noctua-golr.berkeleybop.org/
